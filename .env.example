# Supabase (las públicas pueden ir al navegador)
# Aquí van las del proyecto alojado. En desarrollo, .env.development.local las
# reemplaza por las de la base local (ver `npx supabase status -o env`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor — nunca con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Voz e interpretación (solo servidor)
GROQ_API_KEY=
# Otra cuenta de Groq, con su propio cupo gratuito: se usa solo si la principal se queda sin cupo (429) o su clave no vale.
GROQ_API_KEY_RESPALDO=
GEMINI_API_KEY=

# Anthropic (solo servidor). Interpreta cada dictado con Claude Haiku 5.5 (ADR-0026; sin la clave, interpreta Groq) y estima cuánto
# aguanta cada fruta una vez al día (ADR-0021; sin la clave, Stock sigue con la tabla). CLAUDE_MODELO_LLM cambia el modelo del intérprete.
# VIDA_UTIL_SIMULADOR_URL solo lo usan las pruebas.
ANTHROPIC_API_KEY=

# Comprobantes electrónicos — sandbox (solo servidor)
LUCODE_API_URL=
LUCODE_TOKEN=
EMISOR_RUC=
EMISOR_RAZON_SOCIAL=

# Aviso del día por Web Push (solo servidor). Se generan con `node scripts/generar-claves-push.mjs`; no se pegan en un chat.
# VAPID_SUBJECT: un correo (mailto:tu@correo.pe) o la dirección https de la app; el servicio de avisos de Google y Apple lo pide.
# CRON_SECRET: con él Vercel llama a /api/cron/resumen-diario (en vercel.json). PUSH_SIMULADOR_URL solo lo usan las pruebas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# La dirección pública de la app: los enlaces de invitación (pnpm cuentas:invitar) llevan aquí.
SITIO_URL=http://127.0.0.1:3000
