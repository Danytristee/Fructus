# Supabase (las públicas pueden ir al navegador)
# Aquí van las del proyecto alojado. En desarrollo, .env.development.local las
# reemplaza por las de la base local (ver `npx supabase status -o env`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor — nunca con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Voz e interpretación (solo servidor)
GROQ_API_KEY=
GEMINI_API_KEY=

# Comprobantes electrónicos — sandbox (solo servidor)
LUCODE_API_URL=
LUCODE_TOKEN=
EMISOR_RUC=
EMISOR_RAZON_SOCIAL=

# La dirección pública de la app: los enlaces de invitación (pnpm cuentas:invitar) llevan aquí.
SITIO_URL=http://127.0.0.1:3000
