{
  "name": "fructus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:prod": "node scripts/entorno-local.mjs pnpm exec next build && playwright test -c playwright.produccion.config.ts",
    "knip": "knip",
    "ci:local": "bash scripts/ci-local.sh",
    "db:invariantes": "supabase db query --local -f scripts/invariantes.sql && echo \"Invariantes: las 13 en orden.\"",
    "db:tipos": "supabase gen types typescript --local --schema public > lib/supabase/tipos-db.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "medir:js": "node scripts/medir-js.mjs",
    "iconos": "node scripts/generar-iconos.mjs",
    "frutas": "node scripts/frutas/generar.mjs",
    "build:local": "node scripts/entorno-local.mjs pnpm exec next build",
    "medir:fluidez": "node scripts/entorno-local.mjs node scripts/medir-fluidez.mjs",
    "medir:pintura": "node scripts/entorno-local.mjs node scripts/medir-pintura.mjs",
    "medir:cpu": "node scripts/entorno-local.mjs node scripts/medir-cpu.mjs",
    "medir:escucha": "node scripts/entorno-local.mjs node scripts/medir-escucha.mjs",
    "cuentas:invitar": "node --env-file=.env.local scripts/invitar.mjs",
    "push:claves": "node scripts/generar-claves-push.mjs",
    "voz:precision": "vitest run --config vitest.voz.config.ts tests/interprete/precision.voz.ts",
    "voz:stt": "vitest run --config vitest.voz.config.ts tests/interprete/stt.voz.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "next": "^16.4.6",
    "onnxruntime-web": "1.31.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "knip": "^6.43.0",
    "supabase": "2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
